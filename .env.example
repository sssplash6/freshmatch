OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Path to the SQLite submissions database. When set, every calculator run is stored.
# On Render this points at the mounted disk; leave unset for local dev to run
# without a database. For local testing you can point it anywhere, e.g.:
#   DATABASE_PATH=./server/data/submissions.sqlite
DATABASE_PATH=

# Token to read collected data via GET /api/submissions. Endpoint is off when unset.
ADMIN_TOKEN=choose-a-long-random-string

# Access codes for the front gate — a comma-separated list; any one passes.
# Hand out different codes to different people; remove one to revoke just it.
# When unset the gate is disabled (everyone passes) — useful for local dev.
#   ACCESS_TOKEN=code1,code2,code3
ACCESS_TOKEN=
