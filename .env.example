OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Path to the SQLite submissions database. When set, every calculator run is stored.
# On Render this points at the mounted disk; leave unset for local dev to run
# without a database. For local testing you can point it anywhere, e.g.:
#   DATABASE_PATH=./server/data/submissions.sqlite
DATABASE_PATH=

# Token to read collected data via GET /api/submissions. Endpoint is off when unset.
ADMIN_TOKEN=choose-a-long-random-string

# Email verification (the gate before results). When RESEND_API_KEY is unset
# (local dev), the 6-digit code is logged to the server console instead of being
# emailed, so the flow still works end-to-end without an email account.
RESEND_API_KEY=
# Verified sender for the code email. Must be on a domain verified in Resend.
# Defaults to Resend's onboarding sender if unset (fine for testing).
VERIFY_FROM=FreshMatch <noreply@yourdomain.com>
# Optional. Stable secret for signing verified-email tokens so they survive a
# server restart. If unset, a random per-process secret is used (tokens just
# invalidate on restart, forcing a harmless re-verify).
VERIFY_SECRET=

# ── Per-College Reports ──────────────────────────────────────────────────────
# Where generated report PDFs (+ JSON sidecars) are cached. Defaults to a
# `reports/` directory next to DATABASE_PATH (i.e. the persistent disk on
# Render), or the OS temp dir when no database is configured.
REPORTS_DIR=
# Disk ceiling for the report cache; oldest reports are evicted past it.
# Default 500000000 (500 MB — roughly 1–2k reports).
REPORTS_MAX_BYTES=
# Optional cheaper model for report prose composition. Falls back to
# OPENROUTER_MODEL when unset. Reports still generate (with deterministic
# template prose) if the model call fails entirely.
OPENROUTER_REPORT_MODEL=
